{
  "name": "atlas-politico",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run data:build && npm run images:check && next dev",
    "build": "npm run data:build && npm run images:check && next build && node scripts/finalize-export.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "capture:preview": "playwright test --project=capturas previa.capture",
    "capture:timeline": "playwright test --project=capturas linha-do-tempo.capture",
    "capture:map": "playwright test --project=capturas mapa.capture",
    "capture:pages": "playwright test --project=capturas paginas.capture",
    "capture:finish": "playwright test -c playwright.export.config.ts --project=capturas acabamento.capture",
    "capture:game": "playwright test -c playwright.export.config.ts --project=capturas jogo.capture",
    "test:export": "playwright test -c playwright.export.config.ts --project=exportacao",
    "test:journeys": "playwright test -c playwright.export.config.ts --project=jornadas",
    "verify:export": "node scripts/check-export.mjs",
    "measure": "node scripts/measure.mjs",
    "measure:game": "node scripts/measure-game.mjs",
    "measure:report": "node scripts/measure-report.mjs",
    "game:coverage": "node --import ./scripts/register.mjs scripts/game-coverage.mts",
    "review:human": "node --import ./scripts/register.mjs scripts/human-review.mts",
    "verify:release": "node --import ./scripts/register.mjs scripts/verify-release.mts",
    "release:check": "npm run check && npm run capturas:verificar && npm run verify:release",
    "importar:decisoes": "node --import ./scripts/register.mjs scripts/importar-decisoes.mts",
    "capturas:verificar": "node --import ./scripts/register.mjs scripts/verificar-capturas.mts",
    "audit:a11y": "node --import ./scripts/register.mjs scripts/audit-a11y.mjs",
    "images": "node --import ./scripts/register.mjs scripts/images.mts",
    "images:check": "node --import ./scripts/register.mjs scripts/images.mts --check",
    "data:validate": "node --import ./scripts/register.mjs scripts/data.mts validate",
    "data:build": "node --import ./scripts/register.mjs scripts/data.mts build",
    "data:report": "node --import ./scripts/register.mjs scripts/data.mts report",
    "data:import": "node --import ./scripts/register.mjs scripts/data.mts import",
    "data:query": "node --import ./scripts/register.mjs scripts/data.mts query",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:export"
  },
  "dependencies": {
    "@types/three": "0.180.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
